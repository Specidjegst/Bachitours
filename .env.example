# Resend API Key (https://resend.com)
RESEND_API_KEY=re_xxxxx

# Operator email (where reservations are sent)
OPERATOR_EMAIL=info@bachitours.com

# Sender email used by Resend (must be verified domain)
SENDER_EMAIL=info@bachitours.com

# WhatsApp number of the operator (digits only, with country code)
NEXT_PUBLIC_OPERATOR_WHATSAPP=385989356521

# Public site URL
NEXT_PUBLIC_SITE_URL=https://bachitours.com
